{
  "manifest_version": 3,
  "name": "VLoader Helper",
  "version": "1.0.0",
  "description": "Sends the current page's video URL to VLoader for downloading.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8765/*"],
  "action": {
    "default_title": "Download with VLoader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
