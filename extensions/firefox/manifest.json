{
  "manifest_version": 2,
  "name": "KazaA v2. revival Helper",
  "version": "2.0.0",
  "description": "Sends the current page's video URL to KazaA v2. revival for downloading.",
  "permissions": ["<all_urls>"],
  "browser_action": {
    "default_title": "Download with KazaA v2. revival",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
