{
  "manifest_version": 2,
  "name": "VLoader Helper",
  "version": "1.0.0",
  "description": "Sends the current page's video URL to VLoader for downloading.",
  "permissions": ["<all_urls>"],
  "browser_action": {
    "default_title": "Download with VLoader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
